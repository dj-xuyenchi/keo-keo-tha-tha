{
  "name": "keo-keo-tha-tha",
  "version": "0.1.0",
  "private": true,
  "main": "electron.js",
  "scripts": {
    "dev": "concurrently \"yarn next\" \"yarn electron\"",
    "next": "next dev",
    "electron": "cross-env ELECTRON_START_URL=http://localhost:3000 electron .",
    "build": "next build",
    "package": "yarn build && electron-builder"
  },
  "dependencies": {
    "next": "15.4.2",
    "react": "19.1.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "15.4.2",
    "typescript": "^5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.example.uibuilder",
    "files": [
      "out/**/*",
      "electron.js"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}
